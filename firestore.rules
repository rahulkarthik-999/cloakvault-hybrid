rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in owner can read/write their own sanitized vault workspaces.
    // Raw PII never leaves the browser: writes must be flagged zeroLeakVerified and may
    // only contain the redacted, cloud-safe field set (no rawText, no entity keymap).
    match /users/{userId}/vaults/{vaultId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.zeroLeakVerified == true
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'category', 'redactedText', 'redactedEntityCount',
          'piiBytesKeptLocal', 'riskScore', 'riskVerdict', 'executiveSummary',
          'findingsCount', 'zeroLeakVerified', 'updatedAt'
        ]);
    }

    match /users/{userId}/telemetry/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !('rawText' in request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
