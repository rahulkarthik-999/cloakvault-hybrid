# Firebase Web App Configuration (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (Required for Firebase AI Logic in production)
# Leave empty in local development to use App Check debug token mode
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true
